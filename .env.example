# Copie para .env.local e preencha. Na Vercel, cadastre as mesmas variáveis
# em Settings → Environment Variables.

# Chave da API do Resend (resend.com/api-keys)
RESEND_API_KEY=

# Para onde vão os leads dos dois formulários.
# Aceita vários endereços separados por vírgula.
LEAD_TO_EMAIL=

# Remetente. O domínio precisa estar verificado no Resend.
# Ex.: "Site Auster <site@austersaude.com.br>"
LEAD_FROM_EMAIL=

# Domínio público do site (usado em canonical, sitemap e Open Graph).
# Precisa ser o host que serve o site em produção, sem barra no final.
NEXT_PUBLIC_SITE_URL=https://austersaude.com.br

# Vercel Blob, onde os leads são gravados em CSV. Na Vercel, conectar o store
# ao projeto já preenche isto sozinho; localmente, copie de
# Storage → seu store → .env.local.
BLOB_READ_WRITE_TOKEN=

# Senha da rota /api/leads/export, que baixa o CSV. Gere uma aleatória:
#   openssl rand -hex 32
LEADS_EXPORT_TOKEN=
